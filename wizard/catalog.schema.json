{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC wizard catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "family",
          "ecosystem",
          "framework",
          "blueprint",
          "roots",
          "nodes",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "ecosystem": {
            "type": "string",
            "minLength": 1
          },
          "framework": {
            "type": "string",
            "minLength": 1
          },
          "blueprint": {
            "type": "string",
            "minLength": 1
          },
          "roots": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "group",
                "owner",
                "question",
                "type",
                "choices",
                "binding",
                "depends_on",
                "allow_na"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "pattern": "^[LG][0-9]{2}$"
                },
                "owner": {
                  "type": "string",
                  "pattern": "^L0[1-8]$"
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "text",
                    "choice",
                    "multi"
                  ]
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "binding": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "allow_na": {
                  "type": "boolean"
                },
                "when": {
                  "type": "object",
                  "required": [
                    "node",
                    "equals"
                  ],
                  "properties": {
                    "node": {
                      "type": "string",
                      "minLength": 1
                    },
                    "equals": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "node",
                "contains",
                "reason"
              ],
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "contains": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
