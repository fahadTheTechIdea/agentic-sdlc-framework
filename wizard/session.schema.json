{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC wizard session v1",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "project_root",
    "mode",
    "created_at",
    "inventory",
    "deliverables",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "new",
        "existing"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "inventory": {
      "type": "object",
      "required": [
        "paths",
        "truncated",
        "scope"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "truncated": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deliverables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "profile",
          "profile_revision",
          "answers"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "profile_revision": {
            "type": "integer",
            "minimum": 1
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "origin",
                "source",
                "reason",
                "status",
                "updated_at"
              ],
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "origin": {
                  "enum": [
                    "user",
                    "observed",
                    "recommendation",
                    "inferred"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "resolved",
                    "in_progress",
                    "needs_review",
                    "not_applicable"
                  ]
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "action"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
