{
  "schema_version": 1,
  "change": "<change identifier and short title>",
  "criteria": "<path or tracker locator of the acceptance criteria reviewers check against>",
  "created_at": "<ISO 8601 timestamp with time zone>",
  "lanes": ["code", "security"],
  "builder": {"id": "<builder id>"},
  "accountable": {"id": "<accountable human or role id>", "name": "<accountable human or role name>"},
